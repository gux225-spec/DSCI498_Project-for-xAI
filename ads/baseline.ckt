; Top Design: "mw_filter_lib:spar_sim:schematic"
; Netlisted using Hierarchy Policy: "Standard"

Options ResourceUsage=yes UseNutmegFormat=no EnableOptim=no TopDesignName="mw_filter_lib:spar_sim:schematic" DcopOutputNodeVoltages=yes DcopOutputPinCurrents=yes DcopOutputAllSweepPoints=no DcopOutputDcopType=0
; Library Name: mw_filter_lib
; Cell Name: halffil
; View Name: schematic
define halffil ( N__1  N__0 ) 
;parameters 
model MSub1 MSUB H=15 mil Er=3.78 Mur=1 Cond=1.0E+306 Hu=1.0E+30 meter T=0.1 mil TanD=0 Rough=0 meter DielectricLossModel=1 FreqForEpsrTanD=1.0 GHz LowFreqForTanD=1.0 kHz HighFreqForTanD=1.0 THz RoughnessModel=2 
MCFIL:CLin2  N__2 N__0 Subst="MSub1" W=31.5 mil S=18.0 mil L=136.0 mil Temp=27.0 
MCFIL:CLin1  N__3 N__2 Subst="MSub1" W=25.5 mil S=3.3 mil L=138.5 mil Temp=27.0 
MLIN2:TL1  N__1 N__3 Subst="MSub1" W=32.0 mil L=100.0 mil Temp=27.0 Mod=1 
end halffil

; Library Name: mw_filter_lib
; Cell Name: cmstpfil
; View Name: schematic
define cmstpfil ( N__0  N__2 ) 
;parameters 
halffil:X1  N__0 N__1 
halffil:X2  N__2 N__1 
end cmstpfil

S_Param:SP1 CalcS=yes CalcY=no CalcZ=no GroupDelayAperture=1e-4 FreqConversion=no FreqConversionPort=1 StatusLevel=2 CalcNoise=no SortNoise=0 BandwidthForNoise=1.0 GHz DevOpPtLevel=0 SPSS_WSP=yes \
SweepVar="freq" SweepPlan="SP1_stim" OutputPlan="SP1_Output" 

SweepPlan: SP1_stim Start=9.0 GHz Stop=15.0 GHz Step=0.01 GHz 

OutputPlan:SP1_Output \
      Type="Output" \
      UseEquationNestLevel=yes \
      EquationNestLevel=2 \
      UseSavedEquationNestLevel=yes \
      SavedEquationNestLevel=2

#load "python","LinearCollapse"
Component Module="LinearCollapse" Type="ModelExtractor" NetworkRepresentation=2
Port:Term2  N__1 0 Num=2 Z=50 Ohm Noise=yes 
Port:Term1  N__2 0 Num=1 Z=50 Ohm Noise=yes 
cmstpfil:X1  N__2 N__1 
